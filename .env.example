# Gemini Developer API key from https://aistudio.google.com/api-keys
GEMINI_API_KEY=PASTE_YOUR_API_KEY_HERE
# Change to a currently available model if needed
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Generate a long random shared token. Same value in both Render services.
APP_ACCESS_TOKEN=REPLACE_WITH_A_LONG_RANDOM_PRIVATE_TOKEN
API_BASE_URL=http://127.0.0.1:8000
# Local Chroma persistence. Render free filesystem is ephemeral.
DATA_DIR=./data
